# The model server is run locally by llama.cpp. The app never calls a hosted LLM.
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=Qwen/Qwen3-1.7B-GGUF:Q8_0
LLM_TIMEOUT_SECONDS=90

# Identify the app to OpenStreetMap. Set a monitored contact before deployment.
OSM_USER_AGENT="GeoAIOutdoorAssistant/0.1 (contact: you@example.com)"
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_FALLBACK_URLS=https://overpass.private.coffee/api/interpreter
OVERPASS_TIMEOUT_SECONDS=8
OSRM_URL=https://router.project-osrm.org

# Optional protection for the public recommendation endpoint.
API_KEY=

# The hackathon examples are Indian locations; relative times use India time.
APP_TIMEZONE=Asia/Kolkata

